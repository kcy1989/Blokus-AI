 "f4c": {
  "average_ranks": [
   "  48| def average_ranks(remaining):",
   "  49|     \"\"\"Competition ranking with **tied places split evenly**.",
   "  50| ",
   "  51|     `remaining` is a list of remaining-cell counts. Lower is better, so the",
   "  52|     smallest count is rank 1. Ties share the average of the places they span:",
   "  53|     with [5, 5, 9] the two fives are joint first and get (1 + 2) / 2 = 1.5,",
   "  54|     and the 9 is third. This is the standard \"1224\" convention, and unlike",
   "  55|     `Game.standings` it never consults a seat number.",
   "  56|     \"\"\"",
   "  57|     order = sorted(range(len(remaining)), key=lambda i: remaining[i])",
   "  58|     ranks = [0.0] * len(remaining)",
   "  59|     i = 0",
   "  60|     while i < len(order):",
   "  61|         j = i",
   "  62|         while j + 1 < len(order) and remaining[order[j + 1]] == remaining[order[i]]:",
   "  63|             j += 1",
   "  64|         # places i+1 .. j+1, shared evenly",
   "  65|         shared = (i + 1 + j + 1) / 2.0",
   "  66|         for k in range(i, j + 1):",
   "  67|             ranks[order[k]] = shared",
   "  68|         i = j + 1",
   "  69|     return ranks"
  ],
  "callers_of_average_ranks": [
   "tools/benchmark.py:48",
   "tools/benchmark.py:161",
   "tests/test_benchmark.py:57",
   "tests/test_benchmark.py:63",
   "tests/test_benchmark.py:65",
   "tests/test_benchmark.py:72"
  ],
  "callers_of_standings": [
   "game.py:203",
   "game.py:204",
   "ui.py:674",
   "ui.py:694",
   "ui.py:1349",
   "ui.py:1350"
  ],
  "engine_is_over": [
   " 210| def is_over(state):",
   " 211|     \"\"\"The game ends only when *all four* players have no legal move.\"\"\"",
   " 212|     return all(state.stuck)"
  ],
  "engine_result": [
   " 194| def remaining_cells(state, owner):",
   " 195|     \"\"\"Unplaced squares: the score. Fewer is better.\"\"\"",
   " 196|     hand = state.hand_bits[owner]",
   " 197|     total = 0",
   " 198|     while hand:",
   " 199|         low = hand & -hand",
   " 200|         total += PIECE_SIZE[low.bit_length() - 1]",
   " 201|         hand ^= low",
   " 202|     return total",
   " 203| ",
   " 204| ",
   " 205| def result(state):",
   " 206|     \"\"\"(remaining cells) for all four owners, indexed by owner id.\"\"\"",
   " 207|     return tuple(remaining_cells(state, o) for o in range(4))"
  ],
  "make_profile_perturbation": [
   "  40| ",
   "  41| ",
   "  42| def make_profile(spec, rng):",
   "  43|     \"\"\"Multiplying a set of base weights by a random 0.7-1.3 perturbation.",
   "  44| ",
   "  45|     The perturbation makes the same personality differ slightly from game to",
   "  46|     game, otherwise the leaderboard would be a replay of one fixed set of",
   "  47|     matchups.",
   "  48|     \"\"\"",
   "  49|     wc, wc2, wb, wd, wo, wl, mr = spec",
   "  50|     u = rng.uniform",
   "  51|     return Profile(",
   "  52|         wc * u(0.7, 1.3), wc2 * u(0.7, 1.3), wb * u(0.7, 1.3), wd * u(0.7, 1.3),",
   "  53|         wo * u(0.7, 1.3), wl * u(0.7, 1.3), mr * u(0.7, 1.3),",
   "  54|     )",
   "  55| "
  ],
  "remaining_cells": [
   " 188|     def remaining_cells(self, owner):",
   " 189|         return sum(MASTER[n][\"size\"] for n in self.hands[owner].names)"
  ],
  "standings": [
   " 191|     def standings(self):",
   " 192|         \"\"\"(owner, remaining) for all four, best first.",
   " 193| ",
   " 194|         Remaining squares *are* the score: the fewer a player leaves on the",
   " 195|         board, the better they did. Ties are ordered by owner so the result is",
   " 196|         deterministic.",
   " 197|         \"\"\"",
   " 198|         rows = [(o, self.remaining_cells(o)) for o in range(4)]",
   " 199|         rows.sort(key=lambda t: (t[1], t[0]))",
   " 200|         return rows"
  ],
  "winner": [
   " 202|     def winner(self):",
   " 203|         best = self.standings()[0][1]",
   " 204|         top = [o for o, rem in self.standings() if rem == best]",
   " 205|         if 0 in top:",
   " 206|             return \"player\" if len(top) == 1 else \"draw\"",
   " 207|         return str(top[0])"
  ]
